+    private Field findSuperclassField(String name) {
+        Class<?> clazz = getClass().getSuperclass();
+        while (clazz != null) {
+            try {
+                return clazz.getDeclaredField(name);
+            } catch (NoSuchFieldException e) {
+                clazz = clazz.getSuperclass();
+            }
+        }
+        return null;
+    }

