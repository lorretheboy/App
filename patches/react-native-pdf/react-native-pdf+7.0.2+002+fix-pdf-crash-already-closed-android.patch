+    @Override
+    protected void onDetachedFromWindow() {
+        // Stop the background rendering thread and clear any pending render tasks
+        // before the superclass closes the PdfDocument. Otherwise an in-flight
+        // render can call openPage() on an already-closed document and crash with
+        // "java.lang.IllegalStateException: Already closed".
+        try {
+            Field handlerField = findSuperclassField("renderingHandler");
+            if (handlerField != null) {
+                handlerField.setAccessible(true);
+                Object handler = handlerField.get(this);
+                if (handler instanceof Handler) {
+                    ((Handler) handler).removeCallbacksAndMessages(null);
+                    try {
+                        handler.getClass().getMethod("stop").invoke(handler);
+                    } catch (NoSuchMethodException ignored) {
+                    }
+                }
+            }
+
+            Field threadField = findSuperclassField("renderingHandlerThread");
+            if (threadField != null) {
+                threadField.setAccessible(true);
+                Object thread = threadField.get(this);
+                if (thread instanceof HandlerThread) {
+                    ((HandlerThread) thread).quitSafely();
+                    try {
+                        ((HandlerThread) thread).join(1000);
+                    } catch (InterruptedException ignored) {
+                        Thread.currentThread().interrupt();
+                    }
+                }
+            }
+        } catch (Exception e) {
+            // Best effort: if the renderer internals differ, fall back to the
+            // AlreadyClosedBehavior.IGNORE backstop configured in the constructor.
+            showLog("onDetachedFromWindow: unable to stop renderer: " + e.getMessage());
+        }
+
+        super.onDetachedFromWindow();
+    }
